# Recommended production setup: create a Devin service user with
# ManageOrgSessions and ViewOrgSessions access. Never put the real key in Git
# or in VITE_* variables.
DEVIN_API_VERSION=v3
DEVIN_API_KEY=cog_replace_me
DEVIN_ORG_ID=org-replace-me
DEVIN_SESSION_ID=devin-replace-me

# For a local demo using the personal API key page, use DEVIN_API_VERSION=v1.
# DEVIN_SESSION_ID can be blank; the proxy will create a session on first use.
